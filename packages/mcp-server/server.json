{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.smith-horn/skillsmith",
  "title": "Skillsmith",
  "description": "Publish versioned agent skills to a team-scoped registry, track drift, and deprecate stale ones.",
  "websiteUrl": "https://skillsmith.app",
  "repository": {
    "url": "https://github.com/smith-horn/skillsmith",
    "source": "github"
  },
  "version": "0.7.6",
  "_meta": {
    "io.skillsmith/categories": ["developer-tools", "ai-agents", "skill-management"],
    "io.skillsmith/keywords": ["claude-code", "agent-skills", "autonomous-agents", "openclaw"]
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@skillsmith/mcp-server",
      "version": "0.7.6",
      "transport": {
        "type": "stdio"
      },
      "runtime": {
        "type": "node",
        "minVersion": "22.0.0"
      }
    }
  ]
}
