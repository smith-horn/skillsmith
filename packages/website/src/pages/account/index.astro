---
/**
 * Team Overview — the account hub's landing page at /account.
 *
 * @see SMI-3897: Team Admin Dashboard (Wave 2b) — original Team Dashboard.
 * @see SMI-4292: Wave 5A — live Supabase queries (closes GitHub #605).
 * @see docs/internal/implementation/account-dashboard-ux-consolidation.md
 *   Decision #1 — this page moved from /account/team; the old personal
 *   dashboard content that used to live here moved to /account/summary.
 *
 * Auth pattern: client-side JS queries via Supabase JS client — SSR auth is
 * unreliable through the Cloudflare edge per ADR-111.
 */

export const prerender = false

import { ClientRouter } from 'astro:transitions'
import Footer from '../../components/Footer.astro'
import AccountSidebar from '../../components/AccountSidebar.astro'
import AccountHubNav from '../../components/AccountHubNav.astro'
import Nav from '../../components/Nav.astro'
import { getSupabaseConfig } from '../../lib/supabase-config'

const supabaseConfig = getSupabaseConfig()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/logo-icon.svg" />
    <meta name="description" content="Team dashboard overview" />
    <title>Team Dashboard | Skillsmith</title>
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      href="https://api.fontshare.com/v2/css?f[]=satoshi@300,400,500,700,900&display=swap"
      rel="stylesheet"
    />
    <script is:inline define:vars={{ supabaseConfig }}>
      window.__SUPABASE_CONFIG__ = supabaseConfig
    </script>
    <ClientRouter />
  </head>
  <body>
    <Nav activePath="/account" />

    <div class="account-shell">
      <AccountSidebar currentPath={Astro.url.pathname} />

      <main class="dashboard-container">
        <h1>Team Dashboard</h1>

        <!-- L2-10: the tab row renders outside/above loading, error, and
             gated states — visible immediately, never gated. -->
        <AccountHubNav currentPath="/account" />

        <!-- Loading skeleton -->
        <div id="loading-state" class="loading-state">
          <p>Loading team data...</p>
        </div>

        <!-- Error alert -->
        <div
          id="error-state"
          class="error-state"
          style="display: none;"
          role="alert"
          aria-live="polite"
        >
          <h3>Failed to load team</h3>
          <p id="error-message">Something went wrong.</p>
          <button type="button" data-action="reload" class="btn btn-primary">Try Again</button>
        </div>

        <!-- Content -->
        <div id="team-content" style="display: none;">
          <section class="section">
            <h2>Team Overview</h2>
            <div class="stats-grid">
              <div class="stat-card">
                <div class="stat-value" id="team-name">—</div>
                <div class="stat-label">Team Name</div>
              </div>
              <div class="stat-card">
                <div class="stat-value" id="member-count">—</div>
                <div class="stat-label">Members</div>
              </div>
              <div class="stat-card">
                <div class="stat-value" id="workspace-count">—</div>
                <div class="stat-label">Workspaces</div>
              </div>
              <div class="stat-card">
                <div class="stat-value" id="skill-count">—</div>
                <div class="stat-label">Shared Skills</div>
              </div>
            </div>
          </section>

          <section class="section">
            <h2>Usage Summary (Last 30 Days)</h2>
            <div class="usage-grid" id="usage-grid">
              <div class="usage-row">
                <span class="usage-label">Total Events</span>
                <span class="usage-value" id="total-events">—</span>
              </div>
              <div class="usage-row">
                <span class="usage-label">API Calls</span>
                <span class="usage-value" id="api-calls">—</span>
              </div>
              <div class="usage-row">
                <span class="usage-label">Skills Installed</span>
                <span class="usage-value" id="skills-installed">—</span>
              </div>
              <div class="usage-row">
                <span class="usage-label">Security Audits</span>
                <span class="usage-value" id="audits-run">—</span>
              </div>
            </div>
          </section>

          <section class="section">
            <h2>Recent Activity</h2>
            <div class="activity-list" id="activity-list">
              <p class="empty-text">No recent activity.</p>
            </div>
          </section>
        </div>
      </main>
    </div>

    <Footer compact />
  </body>
</html>

<style>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family:
      'Satoshi',
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      Roboto,
      sans-serif;
    line-height: 1.6;
    color: #fafafa;
    background: #0d0d0f;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .dashboard-container {
    flex: 1;
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem;
    width: 100%;
  }

  .dashboard-container h1 {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }

  .section {
    background: #121214;
    border: 1px solid #2a2a2f;
    border-radius: 0.75rem;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .section h2 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }

  .stat-card {
    background: #1a1a1f;
    border-radius: 0.5rem;
    padding: 1.25rem;
    text-align: center;
  }

  .stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: #fafafa;
    margin-bottom: 0.25rem;
  }

  .stat-label {
    font-size: 0.8125rem;
    color: #9ca3af;
  }

  .usage-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .usage-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 0;
    border-bottom: 1px solid #2a2a2f;
  }

  .usage-row:last-child {
    border-bottom: none;
  }

  .usage-label {
    color: #9ca3af;
    font-size: 0.875rem;
  }

  .usage-value {
    font-weight: 600;
    font-size: 0.875rem;
  }

  .activity-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .activity-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid #2a2a2f;
    font-size: 0.875rem;
    flex-wrap: wrap;
  }

  .activity-item:last-child {
    border-bottom: none;
  }

  .activity-text {
    color: #fafafa;
    flex: 1 1 auto;
    min-width: 0;
  }

  .activity-time {
    color: #9ca3af;
    margin-left: auto;
    font-size: 0.8125rem;
    white-space: nowrap;
  }

  .loading-state {
    padding: 4rem 2rem;
    text-align: center;
    color: #9ca3af;
  }

  .error-state {
    background: rgba(239, 68, 68, 0.08);
    border-left: 3px solid #ef4444;
    border-radius: 0.5rem;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .error-state h3 {
    color: #f87171;
    margin-bottom: 0.5rem;
  }

  .error-state p {
    color: #9ca3af;
    margin-bottom: 1rem;
  }

  .btn {
    padding: 0.5rem 1rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    font-weight: 500;
    border: none;
    cursor: pointer;
  }

  .btn-primary {
    background: #b8523a;
    color: #fafafa;
  }

  .empty-text {
    color: #9ca3af;
    font-size: 0.875rem;
    padding: 0.5rem 0;
  }

  @media (max-width: 640px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script>
  import { createClient } from '@supabase/supabase-js'
  import { checkTeamAccess } from '../../lib/team-access'
  import {
    loadTeamOverviewData,
    resolveOverviewRedirect,
    isTeamEntitled,
  } from '../../lib/account-overview-data'
  import { resyncStripeEmailIfPending } from '../../lib/account-flags'

  const config = window.__SUPABASE_CONFIG__ || { url: '', anonKey: '' }

  function escapeHtml(text: string): string {
    const div = document.createElement('div')
    div.textContent = text
    return div.innerHTML
  }

  function showState(state: 'loading' | 'content' | 'error', message?: string) {
    const loading = document.getElementById('loading-state') as HTMLDivElement
    const content = document.getElementById('team-content') as HTMLDivElement
    const errorEl = document.getElementById('error-state') as HTMLDivElement
    const errorMsg = document.getElementById('error-message') as HTMLParagraphElement
    if (loading) loading.style.display = 'none'
    if (content) content.style.display = 'none'
    if (errorEl) errorEl.style.display = 'none'
    if (state === 'loading' && loading) loading.style.display = 'block'
    if (state === 'content' && content) content.style.display = 'block'
    if (state === 'error' && errorEl) {
      errorEl.style.display = 'block'
      if (message && errorMsg) errorMsg.textContent = message
    }
  }

  // M9: the tab row itself never fetches entitlement data — this page sets
  // the signal on its nav root once the team gate resolves.
  function setTeamEntitled(entitled: boolean) {
    document.querySelector('.account-hub-nav')?.setAttribute('data-team-entitled', String(entitled))
  }

  document.addEventListener('astro:page-load', async () => {
    // Only run on this page. L13: this guard used to accept /account/team
    // and /account/team/ — it now accepts /account and /account/ since this
    // page moved here (Decision #1).
    if (window.location.pathname !== '/account' && window.location.pathname !== '/account/') return

    // Bind CSP-safe reload handler (SMI-4311)
    document.querySelectorAll<HTMLButtonElement>('[data-action="reload"]').forEach((btn) => {
      btn.addEventListener('click', () => {
        window.location.reload()
      })
    })

    if (!config.url || !config.anonKey) {
      showState('error', 'Configuration error — Supabase is not set up.')
      return
    }

    const supabase = createClient(config.url, config.anonKey)

    // SMI-4321: tier-gate runs before any team data query. Authoritative
    // check lives in the check_team_tier_access RPC — a stale session
    // cookie cannot grant access because the RPC reads live
    // profiles/subscriptions at request time. Frozen per the plan; only
    // this call site's branching on the result changed (Decision #4/C1).
    const gate = await checkTeamAccess(supabase)
    setTeamEntitled(isTeamEntitled(gate))

    if (!gate.ok) {
      const redirect = resolveOverviewRedirect(gate)
      if (redirect) {
        // L2-10: fires from this loading state — never a flash of team
        // content or a gated notice.
        window.location.href = redirect
        return
      }
      showState('error', 'You are not a member of any team yet.')
      return
    }

    const teamId = gate.teamId as string

    // Session still needed for user_id on downstream queries; RPC already
    // validated auth.uid() so this call is effectively guaranteed.
    const {
      data: { session },
    } = await supabase.auth.getSession()
    if (!session) {
      // L13: this literal used to read /account/team.
      window.location.href = '/login?redirect=/account'
      return
    }

    // SMI-5168: after a confirmed email change, best-effort resync the new
    // email to the user's Stripe customer.
    void resyncStripeEmailIfPending(config.url, session.access_token)

    try {
      const data = await loadTeamOverviewData(supabase, teamId)

      document.getElementById('team-name')!.textContent = data.teamName
      document.getElementById('member-count')!.textContent = String(data.memberCount)
      document.getElementById('workspace-count')!.textContent = String(data.workspaceCount)
      document.getElementById('skill-count')!.textContent = String(data.skillCount)

      if (data.usage) {
        document.getElementById('total-events')!.textContent = String(data.usage.totalEvents)
        document.getElementById('api-calls')!.textContent = String(data.usage.apiCalls)
        document.getElementById('skills-installed')!.textContent = String(
          data.usage.skillsInstalled
        )
        document.getElementById('audits-run')!.textContent = String(data.usage.auditsRun)
      }

      const list = document.getElementById('activity-list')!
      if (data.activity.length > 0) {
        list.innerHTML = data.activity
          .map(
            ({ text, iso, relative }) => `<div class="activity-item">
              <span class="activity-text">${escapeHtml(text)}</span>
              <span class="activity-time" title="${escapeHtml(iso)}">${escapeHtml(relative)}</span>
            </div>`
          )
          .join('')
      }

      showState('content')
    } catch (err) {
      console.error('Team dashboard load failed:', err)
      showState('error', err instanceof Error ? err.message : 'Unexpected error.')
    }
  })
</script>
