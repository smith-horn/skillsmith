{
  "name": "@smith-horn/enterprise",
  "version": "0.3.7",
  "description": "Publish versioned agent skills to a team-scoped registry, catch drift across installs, and deprecate what's gone stale.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./audit": {
      "types": "./dist/src/audit/index.d.ts",
      "import": "./dist/src/audit/index.js",
      "default": "./dist/src/audit/index.js"
    },
    "./audit/streaming": {
      "types": "./dist/src/audit/streaming/EventStream.d.ts",
      "import": "./dist/src/audit/streaming/EventStream.js",
      "default": "./dist/src/audit/streaming/EventStream.js"
    },
    "./license": {
      "types": "./dist/src/license/index.d.ts",
      "import": "./dist/src/license/index.js",
      "default": "./dist/src/license/index.js"
    },
    "./billing": {
      "types": "./dist/src/billing/index.d.ts",
      "import": "./dist/src/billing/index.js",
      "default": "./dist/src/billing/index.js"
    }
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/lib/forbid-local-publish.mjs && npm run build && npm run test",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "3.1106.0",
    "@opentelemetry/instrumentation-aws-sdk": "0.76.0",
    "@skillsmith/core": "^0.11.7",
    "jose": "^6.2.2",
    "stripe": "20.3.0",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@skillsmith/mcp-server": "^0.7.9",
    "@smithy/config-resolver": "4.6.16",
    "@smithy/core": "3.31.1",
    "@smithy/middleware-endpoint": "4.6.16",
    "@smithy/middleware-retry": "4.7.16",
    "@smithy/protocol-http": "5.5.16",
    "@smithy/smithy-client": "4.14.16",
    "@smithy/types": "4.16.1",
    "@smithy/util-retry": "4.5.16",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@skillsmith/mcp-server": "^0.7.9"
  },
  "peerDependenciesMeta": {
    "@skillsmith/mcp-server": {
      "optional": true
    }
  },
  "files": [
    "dist"
  ],
  "license": "Elastic-2.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/smith-horn/skillsmith.git",
    "directory": "packages/enterprise"
  },
  "homepage": "https://skillsmith.app/enterprise",
  "bugs": {
    "url": "https://github.com/smith-horn/skillsmith/issues",
    "email": "enterprise@skillsmith.app"
  },
  "keywords": [
    "ai",
    "skills",
    "mcp",
    "enterprise",
    "audit"
  ],
  "engines": {
    "node": ">=22.22.0"
  }
}
