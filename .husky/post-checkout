#!/bin/sh
# Post-checkout hook — SMI-5343: originally auto-installed / advised when
# package-lock.json differed between the old and new HEAD after a branch
# switch. SMI-6614 (ADR-158): no longer installs anything here — see
# .husky/post-merge's header for the full rationale (this hook answers the
# same "does the lockfile delta need an install?" question and must not
# disagree with post-merge about it). Classify, then either do nothing
# (fresh/cosmetic) or print the shared, ordered refresh advice (real/
# unknown) for a human to run.
#
# Git invokes this hook with three positional arguments:
#   $1 = prev_HEAD  (SHA before checkout)
#   $2 = new_HEAD   (SHA after checkout)
#   $3 = branch_flag  (1 = branch checkout, 0 = file checkout)
#
# Guard conditions — ALL must hold before classifying anything:
#   1. $3 == 1   — branch checkout only; skip file/path checkouts ($3 == 0)
#   2. $1 is NOT all-zeros — skip initial / orphan checkout (detached new worktree)
#   3. $1 != $2  — skip no-op checkouts
#   4. package-lock.json differs between $1 and $2
#
# Note: interactive rebase fires this hook once per applied commit. The lockfile
# diff gate (condition 4) makes that a no-op for the common case where the
# rebase doesn't change package-lock.json.
#
# Non-blocking (git ignores the exit code of post-checkout; we always exit 0).

# Color codes (match post-merge style)
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

PREV_HEAD="${1:-}"
NEW_HEAD="${2:-}"
BRANCH_FLAG="${3:-0}"
ALL_ZEROS="0000000000000000000000000000000000000000"

# Guard 1: branch checkout only
if [ "$BRANCH_FLAG" != "1" ]; then
  exit 0
fi

# Guard 2: skip initial/orphan checkout (prev_HEAD is all-zeros)
if [ "$PREV_HEAD" = "$ALL_ZEROS" ]; then
  exit 0
fi

# Guard 3: skip no-op checkout
if [ "$PREV_HEAD" = "$NEW_HEAD" ]; then
  exit 0
fi

# Guard 4: package-lock.json must differ between prev and new HEAD
if ! git diff --name-only "$PREV_HEAD" "$NEW_HEAD" 2>/dev/null | grep -q '^package-lock\.json$'; then
  exit 0
fi

echo ""
echo "${BLUE}=== Post-Checkout: package-lock.json changed ===${NC}"
echo ""

# SMI-5628: linked-worktree detection (same idiom as .husky/post-merge's
# SMI-5624 guard and scripts/lib/check-node-modules-fresh.sh).
_gcd="$(git rev-parse --git-common-dir 2>/dev/null)"
_gd="$(git rev-parse --git-dir 2>/dev/null)"
_IS_LINKED_WT=0
_MAIN_CHECKOUT=""
if [ -n "$_gcd" ] && [ "$_gcd" != "$_gd" ]; then
  _IS_LINKED_WT=1
  _MAIN_CHECKOUT="$(cd "$_gcd/.." 2>/dev/null && pwd || echo '')"
fi
_ADVICE_MAIN="$_MAIN_CHECKOUT"
if [ -z "$_ADVICE_MAIN" ]; then
  _ADVICE_MAIN="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
fi

# --- One classifier decides everything below (SMI-6606/SMI-6614) -----------
# Same shape as .husky/post-merge — resolved relative to THIS hook file's own
# location, overridable via the same test seam name so a shared stub works
# for both hooks' tests.
CLASSIFY_LIB="${SKILLSMITH_DEPS_CLASSIFY_SCRIPT_TEST:-$(dirname "$0")/../scripts/lib/check-node-modules-fresh.sh}"
ADVICE_LIB="$(dirname "$0")/../scripts/lib/print-deps-refresh-advice.sh"

# Status and token are captured SEPARATELY — a classifier that prints a
# valid token but exits non-zero must NOT be trusted; only exit 0 with a
# recognized token is accepted. See .husky/post-merge's identical logic.
VERDICT="unknown"
if [ -r "$CLASSIFY_LIB" ]; then
  _CLASSIFY_OUT="$(sh "$CLASSIFY_LIB" --classify 2>/dev/null)"
  _CLASSIFY_RC=$?
  if [ "$_CLASSIFY_RC" -eq 0 ]; then
    case "$_CLASSIFY_OUT" in
      fresh | cosmetic | real | unknown) VERDICT="$_CLASSIFY_OUT" ;;
      *) VERDICT="unknown" ;;
    esac
  fi
fi

if [ "$_IS_LINKED_WT" = "1" ]; then
  echo "${YELLOW}Linked worktree — no install runs from here.${NC}"
  echo "  node_modules here is a symlink into the main checkout, and this worktree's"
  echo "  own container mounts node_modules read-only (SMI-5560/SMI-5626) — installing"
  echo "  in either place would corrupt state or fail (EROFS)."
  echo ""
  if [ -r "$ADVICE_LIB" ]; then
    sh "$ADVICE_LIB" "$_ADVICE_MAIN"
  fi
else
  case "$VERDICT" in
    fresh)
      echo "${GREEN}Dependencies already match package-lock.json — nothing to do.${NC}"
      ;;
    cosmetic)
      echo "${GREEN}package-lock.json changed only in workspace-self version fields —${NC}"
      echo "${GREEN}installed dependencies still match. No install needed.${NC}"
      ;;
    *)
      echo "${YELLOW}A real dependency change was detected (or the classifier result${NC}"
      echo "${YELLOW}could not be determined) — this hook no longer installs${NC}"
      echo "${YELLOW}automatically (SMI-6614, ADR-158): an unattended install here has${NC}"
      echo "${YELLOW}broken other sessions' containers before. Refresh manually:${NC}"
      echo ""
      if [ -r "$ADVICE_LIB" ]; then
        sh "$ADVICE_LIB" "$_ADVICE_MAIN"
      fi
      ;;
  esac
fi

echo ""

exit 0
