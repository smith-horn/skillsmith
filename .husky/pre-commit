#!/bin/sh
# SMI-1346: Enhanced pre-commit hook with early lint error detection
# SMI-1774: Use Docker for typecheck to ensure consistent environment

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo ""
echo "${BLUE}=== Pre-Commit Checks ===${NC}"
echo ""

# =============================================================================
# SMI-2536: Branch Integrity Guard
# Record the current branch so we can verify it doesn't change during commit.
# Git-crypt smudge filters can silently switch branches during stash/pop.
# =============================================================================
EXPECTED_BRANCH=$(git branch --show-current)
if [ -n "$EXPECTED_BRANCH" ]; then
  echo "$EXPECTED_BRANCH" > "$(git rev-parse --git-dir)/expected-branch"
fi

# =============================================================================
# Detect execution environment (Docker vs Local) — SMI-4681 / SMI-4686
# Source shared detection helper. Sets DOCKER_AVAILABLE, USE_DOCKER, FELL_BACK,
# CONTAINER_WD, IS_WORKTREE, RUN_PREFIX; defines run_cmd, hook_debug.
# Graceful degradation if the helper is missing (push from a worktree on a
# branch that predates SMI-4686).
# =============================================================================
HOOK_DETECT_LIB="$(dirname "$0")/../scripts/lib/hook-docker-detect.sh"
if [ -r "$HOOK_DETECT_LIB" ]; then
  # SMI-6568: caller contract — pre-commit classifies the STAGED set, not
  # the committed range. Unexported: this hook sources the lib directly in
  # the same shell, so no child process needs to see it.
  # shellcheck disable=SC2034 # read by the sourced hook-docker-detect.sh
  HOOK_DETECT_CALLER=pre-commit
  # shellcheck source=../scripts/lib/hook-docker-detect.sh
  . "$HOOK_DETECT_LIB"
else
  echo "${YELLOW}⚠️  scripts/lib/hook-docker-detect.sh missing — using legacy in-container path${NC}"
  echo "${YELLOW}   (rebase onto main to pick up SMI-4686)${NC}"
  DOCKER_AVAILABLE=1
  USE_DOCKER=1
  FELL_BACK=0
  CONTAINER_WD="/app"
  DOCKER_CONTAINER="skillsmith-dev-1"
  # SMI-6985 L-1: set for parity with hook-docker-detect.sh's full fallback
  # contract (line 29's own comment: "Sets ... RUN_PREFIX") so this
  # legacy-path branch leaves every var the sourced lib would have set, even
  # though pre-commit itself (unlike pre-push, which prints a "Run: $RUN_PREFIX
  # ..." fix-hint) doesn't read it today.
  # shellcheck disable=SC2034 # see comment above: set for fallback-contract parity, not read in this hook
  RUN_PREFIX="docker exec ${DOCKER_CONTAINER}"
  run_cmd() {
    docker exec -w "$CONTAINER_WD" "$DOCKER_CONTAINER" "$@"
  }
fi

if [ "$USE_DOCKER" = "1" ]; then
  echo "${BLUE}🐳 Using Docker container: ${DOCKER_CONTAINER}${NC}"
elif [ "$DOCKER_AVAILABLE" = "0" ] && [ "$FELL_BACK" = "0" ]; then
  echo "${YELLOW}ℹ️  Docker not available - using local environment${NC}"
fi
echo ""

# Phase 0: Secret Detection with Gitleaks
echo "${YELLOW}[0/3] Scanning for secrets...${NC}"
if gitleaks protect --staged --no-banner 2>/dev/null; then
    echo "${GREEN}  ✓ No secrets detected${NC}"
else
    echo ""
    echo "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo "${RED}  ✗ Potential Secrets Detected!${NC}"
    echo "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo "  ${YELLOW}Details:${NC}"
    gitleaks protect --staged --no-banner -v 2>/dev/null || true
    echo ""
    echo "  ${YELLOW}How to fix:${NC}"
    echo "    1. Remove the secret from your staged files"
    echo "    2. Use environment variables instead"
    echo "    3. Add to .env (which is gitignored)"
    echo ""
    echo "  ${YELLOW}False positive?${NC} Add to .gitleaks.toml allowlist"
    echo ""
    exit 1
fi

# =============================================================================
# node_modules freshness guard (SMI-5343 / SMI-5344 #1) — WARN, never block.
# Drift here is environmental (a stale tree vs package-lock.json), not a problem
# with the staged change, so the highest-frequency gate must NOT manufacture
# `--no-verify` pressure. The detector prints the one context-correct fix; we
# always `exit 0` (continue) so the existing typecheck phase still surfaces real
# type errors and this warning pre-explains any module-resolution noise.
#
# READ-ONLY by contract (P-5): the detector never runs npm install or mutates
# the shared tree. We perform NO git stash/checkout/branch op here — the
# SMI-2536 branch-integrity guard relies on the branch not moving.
# The detector runs as a CHILD `sh` process (not sourced), so it does NOT
# inherit USE_DOCKER / IS_WORKTREE / color vars from this hook. It defines its
# own color fallbacks and prints the dual-tree fix (it cannot know the parent's
# Docker/worktree context across the process boundary, and a stale lockfile
# usually leaves both the host and container trees behind anyway).
# =============================================================================
FRESHNESS_LIB="$(dirname "$0")/../scripts/lib/check-node-modules-fresh.sh"
if [ -r "$FRESHNESS_LIB" ]; then
  if ! sh "$FRESHNESS_LIB"; then
    echo "${YELLOW}  ⚠️  Continuing (pre-commit warns on stale deps; pre-push will block).${NC}"
  fi
fi

# =============================================================================
# dist-freshness guard (SMI-5548) — WARN, never block.
# Same rationale as the node_modules freshness guard above: a stale dist/ is
# an environmental "you forgot to rebuild" issue, not a problem with the
# staged change, so the highest-frequency gate must NOT manufacture
# `--no-verify` pressure. pre-push (BLOCK) is the enforcement point.
# =============================================================================
DIST_LIB="$(dirname "$0")/../scripts/lib/check-dist-fresh.sh"
if [ -r "$DIST_LIB" ]; then
  if ! sh "$DIST_LIB"; then
    echo "${YELLOW}  ⚠️  Continuing (pre-commit warns on stale dist/; pre-push will block).${NC}"
  fi
fi

# Phase 1: Clear TypeScript build cache (SMI-1348)
# Only clear cache if FULL_TYPECHECK=1 (e.g., CI or explicit request)
# Clearing cache causes ALL packages to rebuild, surfacing pre-existing errors
# in unchanged files. Incremental builds are safer for developer workflow.
if [ "$FULL_TYPECHECK" = "1" ]; then
  echo "${YELLOW}[1/3] Clearing TypeScript build cache (FULL_TYPECHECK=1)...${NC}"
  run_cmd npx tsc --build --clean > /dev/null 2>&1 || true
  echo "${GREEN}  ✓ Build cache cleared${NC}"
else
  echo "${YELLOW}[1/3] Using incremental TypeScript build cache...${NC}"
  echo "${GREEN}  ✓ Cache preserved (set FULL_TYPECHECK=1 for full rebuild)${NC}"
fi

# Phase 2: TypeScript Type Checking (SMI-1886: Optimized to check only changed packages)
echo "${YELLOW}[2/3] Running TypeScript type check...${NC}"

# Detect which packages have staged changes
CHANGED_PACKAGES=$(git diff --cached --name-only | grep '^packages/' | cut -d'/' -f2 | sort -u)
NON_PACKAGE_CHANGES=$(git diff --cached --name-only | grep -v '^packages/' | grep -E '\.(ts|tsx)$' | head -1)

TYPECHECK_FAILED=0
PACKAGES_CHECKED=""

# If we have non-package TypeScript changes OR no package-specific changes, run full typecheck
if [ -n "$NON_PACKAGE_CHANGES" ] || [ -z "$CHANGED_PACKAGES" ]; then
    echo "  Running full typecheck (non-package changes detected)..."
    if ! run_cmd npm run typecheck; then
        TYPECHECK_FAILED=1
    fi
    PACKAGES_CHECKED="all"
else
    # Only typecheck packages with staged changes
    for pkg in $CHANGED_PACKAGES; do
        PKG_TSCONFIG="packages/$pkg/tsconfig.json"
        if [ -f "$PKG_TSCONFIG" ]; then
            echo "  Checking packages/$pkg..."
            if ! run_cmd npx tsc --noEmit --project "$PKG_TSCONFIG"; then
                TYPECHECK_FAILED=1
            fi
            PACKAGES_CHECKED="$PACKAGES_CHECKED $pkg"
        fi
    done
fi

if [ $TYPECHECK_FAILED -eq 0 ]; then
    if [ "$PACKAGES_CHECKED" = "all" ]; then
        echo "${GREEN}  ✓ TypeScript check passed (full)${NC}"
    else
        echo "${GREEN}  ✓ TypeScript check passed (packages:$PACKAGES_CHECKED)${NC}"
    fi
else
    echo ""
    echo "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo "${RED}  ✗ TypeScript Errors Found${NC}"
    echo "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo "  ${YELLOW}How to fix:${NC}"
    echo "    1. Review the errors above"
    echo "    2. Fix type errors in the listed files"
    if [ $USE_DOCKER -eq 1 ]; then
      echo "    3. Run 'docker exec -w $CONTAINER_WD $DOCKER_CONTAINER npm run typecheck' to verify"
    else
      echo "    3. Run 'npm run typecheck' to verify fixes"
    fi
    echo ""
    echo "  ${YELLOW}Emergency bypass:${NC} git commit --no-verify"
    echo ""
    exit 1
fi

# Phase 3: Lint and Format (staged files only)
# SMI-2604: --no-stash prevents lint-staged from running git stash push/pop,
# which triggers git-crypt smudge filters that silently switch branches.
echo "${YELLOW}[3/3] Running lint and format on staged files...${NC}"

# SMI-retro: Snapshot staged files before lint-staged to prevent re-staging unrelated changes.
# --no-stash (SMI-2604) prevents smudge filter branch switches but lets lint-staged operate
# on the full working tree. After lint-staged, we re-add only originally-staged files.
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d)

# SMI-5713: source the gitlink-preservation library (scripts/lib/preserve-gitlinks.sh
# has the full rationale). Missing-lib case degrades LOUDLY, not silently — a stale
# checkout must not reintroduce this bug without at least a visible warning.
PRESERVE_GITLINKS_LIB="$(dirname "$0")/../scripts/lib/preserve-gitlinks.sh"
if [ -r "$PRESERVE_GITLINKS_LIB" ]; then
  # shellcheck source=../scripts/lib/preserve-gitlinks.sh
  . "$PRESERVE_GITLINKS_LIB"
else
  echo "${YELLOW}⚠️  scripts/lib/preserve-gitlinks.sh missing — gitlink clobber protection disabled (rebase onto main to pick up SMI-5713)${NC}"
  capture_staged_gitlinks() { :; }
  restore_staged_gitlinks() { :; }
fi
STAGED_GITLINKS=$(capture_staged_gitlinks)

# SMI-4451 Step 5 — frontmatter lint mode flag, consumed by the
# `docs/internal/retros/*.md` rule in lint-staged.config.js. Default is
# `warn` for the Wave 1 soak window. Flip to `error` ONLY after the 3-AND
# precondition lands (15 consecutive complete + 0 bypassed + bypass logging
# alive — see docs/internal/implementation/smi-4450-step5-frontmatter-lint.md
# §S4 gate-flip precondition).
export RETRO_FRONTMATTER_MODE="${RETRO_FRONTMATTER_MODE:-warn}"

if npx lint-staged --no-stash; then
    # Re-stage only originally-staged files (formatters may have modified them)
    if [ -n "$STAGED_FILES" ]; then
      echo "$STAGED_FILES" | xargs git add --
    fi
    # SMI-5713: Re-apply staged gitlink SHAs the blind `git add` above
    # replaced with the locally-checked-out submodule commit.
    restore_staged_gitlinks "$STAGED_GITLINKS"
    echo "${GREEN}  ✓ Lint and format passed${NC}"
else
    echo ""
    echo "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo "${RED}  ✗ Lint Errors Found${NC}"
    echo "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo "  ${YELLOW}Common issues and fixes:${NC}"
    echo ""
    echo "  ${BLUE}Unused imports:${NC}"
    echo "    - Remove: import { UnusedType } from './module'"
    echo "    - Or prefix with underscore: import { _UnusedType } from './module'"
    echo ""
    echo "  ${BLUE}Unused variables:${NC}"
    echo "    - Remove the variable declaration"
    echo "    - Or prefix with underscore: const _unused = value"
    echo ""
    echo "  ${BLUE}Unnecessary escapes in regex:${NC}"
    echo "    - Remove backslash: /\\)/ → /\\)/ (if needed) or /\)/ → /)/"
    echo ""
    echo "  ${YELLOW}Quick fix:${NC}"
    echo "    npm run lint:fix    # Auto-fix what can be fixed"
    echo "    npm run lint        # See remaining errors"
    echo ""
    echo "  ${YELLOW}Emergency bypass:${NC} git commit --no-verify"
    echo ""
    exit 1
fi

# =============================================================================
# SMI-5983: clears the DISABLED-state marker (written by rebase-worktree.sh's
# Step 7 / this hook's own branch-switch recovery below). Deliberately kept
# isolated from the filter-restore config lines it's called near, and this
# comment deliberately avoids the two literal substrings its own line below
# combines (a certain git-config removal flag, plus a git-crypt filter key
# mention) -- see scripts/tests/git-crypt-remediation-strings.test.ts (SMI-
# 5702 T11) for why: that guard flags exactly that combination anywhere in
# the repo, so even explaining the pairing in prose here would self-trip it.
# =============================================================================
# SMI-5983-TEST:BEGIN clear-marker -- scripts/tests/git-crypt-pre-commit-disable.test.ts
# extracts this span too. Read at test-run time (not embedded as a literal
# string in that .ts file's own source text), so this does not trip the
# SMI-5702 T11 guard the comment above already explains.
_clear_git_crypt_marker() {
  _cgm_rc=0
  git config --local --unset skillsmith.git-crypt-disabled-marker 2>/dev/null || _cgm_rc=$?
  # R4: exit 5 = key absent (measured) = already clear.
  if [ "$_cgm_rc" -eq 5 ]; then _cgm_rc=0; fi
  return "$_cgm_rc"
}
# SMI-5983-TEST:END clear-marker

# =============================================================================
# SMI-2536 / SMI-2747: Branch Integrity Guard — Verify branch didn't switch.
# If it did, auto-restore using smudge-safe checkout so the user only needs to
# re-run `git commit` (no manual recovery steps required).
# =============================================================================
if [ -n "$EXPECTED_BRANCH" ]; then
  CURRENT_BRANCH=$(git branch --show-current)
  if [ "$CURRENT_BRANCH" != "$EXPECTED_BRANCH" ]; then
    echo ""
    echo "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo "${RED}  ABORTING: Branch switched — auto-restoring to $EXPECTED_BRANCH${NC}"
    echo "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo "  Expected branch: ${YELLOW}$EXPECTED_BRANCH${NC}"
    echo "  Current branch:  ${YELLOW}$CURRENT_BRANCH${NC}"
    echo ""

    # SMI-5983/SMI-6973: lock library (contract, rationale, why absence is
    # FATAL): scripts/lib/git-crypt-lock.sh. Held around classify+disable+
    # marker-write, released before the checkout, reacquired for the restore.
    GIT_CRYPT_LOCK_LIB="$(dirname "$0")/../scripts/lib/git-crypt-lock.sh"
    if [ ! -r "$GIT_CRYPT_LOCK_LIB" ]; then
      echo "${RED}  git-crypt lock library missing or unreadable:${NC}" >&2
      echo "    $GIT_CRYPT_LOCK_LIB" >&2
      echo "  Refusing to disable git-crypt filters without the lock that" >&2
      echo "  serialises it -- scripts/_lib.sh's bash helpers contend on the" >&2
      echo "  same lock across every worktree." >&2
      echo "  Fix: rebase onto a revision containing that file (SMI-6973)." >&2
      exit 1
    fi
    # shellcheck source=../scripts/lib/git-crypt-lock.sh
    . "$GIT_CRYPT_LOCK_LIB"

    # SMI-5983-TEST:BEGIN disabled-precheck -- scripts/tests/git-crypt-pre-commit-disable.test.ts
    # extracts this span too; it depends on the lock helpers, which since
    # SMI-6973 live in scripts/lib/git-crypt-lock.sh rather than in a sibling
    # span -- a harness must SOURCE that library before running this span,
    # plus set EXPECTED_BRANCH itself.
    _acquire_git_crypt_lock
    # SMI-6973: bare command substitutions here aborted under `sh -e` on a
    # merely-unset key, leaking the lock. Rationale in git-crypt-lock.sh.
    _read_git_crypt_cfg SMUDGE_CMD filter.git-crypt.smudge
    _read_git_crypt_cfg CLEAN_CMD filter.git-crypt.clean

    # SMI-5983: hard-fail if filters are ALREADY disabled (both "cat") --
    # the identical corruption bug fixed in scripts/rebase-worktree.sh's
    # step_disable_filters(): capturing "cat" into SMUDGE_CMD/CLEAN_CMD as
    # if it were the real original, then restoring to that bogus value.
    # Does NOT suggest `git commit --no-verify` here (unlike the success
    # message below) -- the branch-integrity guard has already detected a
    # mismatch, so advertising a bypass could commit directly on the wrong
    # branch, compounding the exact problem this hook exists to prevent.
    if [ "$SMUDGE_CMD" = "cat" ] && [ "$CLEAN_CMD" = "cat" ]; then
      _release_git_crypt_lock || true # exits 1 below; the EXIT handler retries
      # SMI-6973: bare, this aborted on an absent marker (the common case
      # here), silently deleting every line of recovery guidance below it.
      _marker=""
      _marker=$(git config --local --get skillsmith.git-crypt-disabled-marker 2>/dev/null) || true
      echo "${RED}  git-crypt filters are already disabled -- refusing to proceed.${NC}"
      if [ -n "$_marker" ]; then
        echo "  Marker: $_marker (PID TIMESTAMP WORKTREE_PATH_BASE64)"
      else
        echo "  No marker found (a pre-SMI-5983 disable, or an unparseable/hand-set state)."
      fi
      echo ""
      echo "  Required recovery:"
      echo "    1. ./scripts/worktree-crypt.sh fix .   # auto-heals if the disabling process is confirmed dead"
      echo "    2. git checkout $EXPECTED_BRANCH"
      echo "    3. git branch --show-current            # confirm it now matches $EXPECTED_BRANCH"
      echo "    4. Retry the commit."
      exit 1
    fi
    # SMI-5983-TEST:END disabled-precheck

    # SMI-2747: Smudge-safe auto-restore.
    # Only capture/manipulate the filter if it is currently configured — avoids
    # adding unexpected git config entries on repos without git-crypt.
    # SMI-5983-TEST:BEGIN restore-definition -- scripts/tests/git-crypt-pre-commit-disable.test.ts
    # extracts this span too (run immediately after the disabled-precheck
    # span above, in the same sourced shell); depends on SMUDGE_CMD/
    # CLEAN_CMD from that span, plus the lock helpers that SMI-6973 moved to
    # scripts/lib/git-crypt-lock.sh (source that library, do not slice it).
    if [ -n "$SMUDGE_CMD" ] || [ -n "$CLEAN_CMD" ]; then
      # SMI-5702: a missing pre-image heals to canonical registration, never to
      # "key removed" (that removal broke every worktree twice, SMI-5702/5861).
      # The literal fallbacks below MUST stay byte-identical to
      # GIT_CRYPT_CANONICAL_SMUDGE/CLEAN in scripts/_lib.sh (duplicated, not
      # sourced: this hook is POSIX sh, _lib.sh is bash-only).
      # SMI-5983: clears the disabled-marker FIRST, before restoring real values
      # (same ordering as scripts/_rebase-git-crypt.sh restore_filter_config()).
      _restore_smudge_filter() {
        # SMI-6973 (H1): acquiring arms the lock library's own EXIT/INT/TERM
        # handlers, which REPLACE the `trap '_restore_smudge_filter' ...` set
        # below. Naming this function as the chained outer handler means a
        # signal or errexit abort mid-restore releases the lock AND re-runs
        # the restoration once, instead of losing it.
        GIT_CRYPT_LOCK_OUTER_TRAP=_restore_smudge_filter
        _acquire_git_crypt_lock
        # SMI-6973 (H1, round 3): this also runs AS the final EXIT trap, where
        # the lock library's re-armed trap never fires -- so no errexit abort
        # between acquire and release. Failures are collected, not fatal.
        _rsf_rc=0
        _rsf_errexit=""
        case $- in *e*) _rsf_errexit=1 ;; esac
        set +e
        _clear_git_crypt_marker || _rsf_rc=1
        git config --local filter.git-crypt.smudge "${SMUDGE_CMD:-git-crypt smudge}" || _rsf_rc=1
        git config --local filter.git-crypt.clean "${CLEAN_CMD:-git-crypt clean}" || _rsf_rc=1
        _release_git_crypt_lock || _rsf_rc=1
        [ -z "$_rsf_errexit" ] || set -e
        if [ "$_rsf_rc" -ne 0 ]; then
          # Outer trap stays set: the EXIT handler re-runs us (R4).
          echo "${RED}  Failed to restore git-crypt filter config; run: ./scripts/worktree-crypt.sh fix .${NC}" >&2
          return 1
        fi
        GIT_CRYPT_LOCK_OUTER_TRAP=""
      }
      # R4: trap status is discarded, so FINAL retries once, then exits. F7: a
      # signal restores, then ENDS the hook (130/143), never continues.
      _restore_smudge_filter_signal() {
        if _restore_smudge_filter; then trap - EXIT INT TERM; fi
        exit "$1"
      }
      _restore_smudge_filter_final() {
        _rsf_st=$?
        _restore_smudge_filter || _restore_smudge_filter || { [ "$_rsf_st" -ne 0 ] || _rsf_st=1; exit "$_rsf_st"; }
      }
      # SMI-6973 F1: until the trap below is armed, an abort or signal runs the
      # lock library's handler. Chain the restore through it NOW, before the
      # first disabling write, so the lock is released AND filters restored.
      GIT_CRYPT_LOCK_OUTER_TRAP=_restore_smudge_filter
      git config --local filter.git-crypt.smudge "cat"
      git config --local filter.git-crypt.clean "cat"
      # Written LAST, after both filter values (rebase-worktree.sh Step 7 order).
      _worktree_b64=$(printf '%s' "$(pwd)" | base64 | tr -d '\n')
      git config --local skillsmith.git-crypt-disabled-marker "$$ $(date +%s) $_worktree_b64"
      # SMI-5983: release BEFORE arming the restore trap (it re-acquires; the
      # lock is not reentrant). See git-crypt-lock.sh "CALLER ORDERING".
      _release_git_crypt_lock || true # a failed removal is retried by the EXIT trap
      trap '_restore_smudge_filter_final' EXIT
      trap '_restore_smudge_filter_signal 130' INT
      trap '_restore_smudge_filter_signal 143' TERM
      # Read by the EXIT/INT/TERM handler in scripts/lib/git-crypt-lock.sh,
      # which shellcheck does not follow; clearing it stops that handler
      # chaining a second restore now that the traps above own it.
      # shellcheck disable=SC2034
      GIT_CRYPT_LOCK_OUTER_TRAP=""
    else
      _release_git_crypt_lock || true # failure is already reported; EXIT retries
    fi
    # SMI-5983-TEST:END restore-definition
    echo "  ${YELLOW}Running smudge-safe checkout...${NC}"
    # SMI-6973: under errexit a failed checkout aborted before `RC=$?` ran, so
    # the "Auto-restore failed" block was unreachable; `|| RC=$?` keeps it live.
    RESTORE_EXIT=0
    git checkout "$EXPECTED_BRANCH" || RESTORE_EXIT=$?
    # SMI-5983-TEST:BEGIN explicit-restore -- git-crypt-lock-errexit.test.ts
    if [ -n "$SMUDGE_CMD" ] || [ -n "$CLEAN_CMD" ]; then
      # R4 (H-b): traps are the retry; drop them only on success.
      if _restore_smudge_filter; then trap - EXIT INT TERM; else RESTORE_EXIT=1; fi
    fi
    # SMI-5983-TEST:END explicit-restore
    if [ $RESTORE_EXIT -eq 0 ]; then
      rm -f "$(git rev-parse --git-dir)/expected-branch"
      echo "${GREEN}  ✓ Restored to $EXPECTED_BRANCH. Staged changes preserved.${NC}"
      echo "    Re-run: ${YELLOW}git commit${NC}"
      echo ""
      echo "  ${YELLOW}Emergency bypass:${NC} git commit --no-verify"
    else
      echo ""
      echo "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
      echo "${RED}  Auto-restore failed. Manual recovery:${NC}"
      echo "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
      echo ""
      # SMI-5702: previously printed a 6-line cat/cat-disable + literal-
      # spelling-restore recipe -- if run out of order, or if the "cat"
      # sentinel step were ever skipped, this reproduced the exact
      # corruption vector this fix eliminates. Single canonical remediation
      # instead (scripts/worktree-crypt.sh fix, backed by
      # ensure_git_crypt_filter_registered() in scripts/_lib.sh).
      echo "    git checkout $EXPECTED_BRANCH  # <- main recovery step"
      echo "    ./scripts/worktree-crypt.sh fix ."
      echo "    git commit  # retry"
      echo ""
      echo "  ${YELLOW}Emergency bypass:${NC} git commit --no-verify"
    fi
    exit 1
  fi
fi

