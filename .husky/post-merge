#!/bin/sh
# Post-merge hook
# - SMI-2552: Auto-install npm dependencies when package-lock.json changes
# - SMI-5343: Also run/advise a HOST npm install (feeds host tooling + worktree
#             symlinks) alongside the existing Docker path.
# Fires after git pull (merge) and git merge. Non-blocking — cannot abort.

# Color codes (match pre-commit style)
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

DOCKER_CONTAINER="skillsmith-dev-1"

# Check if package-lock.json changed in the merge
# ORIG_HEAD = tip before merge, HEAD = after merge
if git diff --name-only ORIG_HEAD HEAD | grep -q '^package-lock\.json$'; then
  echo ""
  echo "${BLUE}=== Post-Merge: package-lock.json changed ===${NC}"
  echo ""

  # SMI-5624: linked-worktree detection, hoisted so BOTH the Docker block and
  # the SMI-5623 host-path guard below share one computation (same idiom as
  # scripts/lib/check-node-modules-fresh.sh).
  _gcd="$(git rev-parse --git-common-dir 2>/dev/null)"
  _gd="$(git rev-parse --git-dir 2>/dev/null)"
  _IS_LINKED_WT=0
  _MAIN_CHECKOUT=""
  if [ -n "$_gcd" ] && [ "$_gcd" != "$_gd" ]; then
    _IS_LINKED_WT=1
    _MAIN_CHECKOUT="$(cd "$_gcd/.." 2>/dev/null && pwd || echo '')"
  fi
  # Note: .husky/post-checkout has the identical hardcoded-container bug and
  # is NOT guarded here — tracked separately as SMI-5628 (found during this
  # same investigation; deliberately out of scope for this fix).

  # --- Docker path (SMI-2552; SMI-5624 linked-worktree guard) -----------------
  # In a linked worktree, "$DOCKER_CONTAINER" is the MAIN checkout's container
  # — installing there from here mistargets, and installing into this
  # worktree's OWN container is wrong-by-design (its node_modules mounts are
  # read-only views of main's tree, SMI-5560/SMI-5626). Skip and advise the
  # main-checkout refresh instead, mirroring the host-path guard below.
  if [ "$_IS_LINKED_WT" = "1" ]; then
    echo "${YELLOW}Skipping Docker npm install — this is a linked worktree.${NC}"
    echo "  Installing here would target MAIN's container by mistake, and installing"
    echo "  into this worktree's OWN container would fail (EROFS) — its node_modules"
    echo "  mounts are read-only views of main's tree (SMI-5560/SMI-5626)."
    if [ -n "$_MAIN_CHECKOUT" ]; then
      echo "  Run instead: ( cd \"$_MAIN_CHECKOUT\" && docker exec $DOCKER_CONTAINER npm install )"
    else
      echo "    docker exec $DOCKER_CONTAINER npm install"
    fi
  elif command -v docker > /dev/null 2>&1 && \
     docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^${DOCKER_CONTAINER}$"; then
    echo "${YELLOW}Installing updated dependencies in Docker...${NC}"
    if docker exec -w /app "$DOCKER_CONTAINER" npm install; then
      echo "${GREEN}  Docker dependencies updated successfully.${NC}"
    else
      echo "${YELLOW}  Docker npm install failed. Run manually:${NC}"
      echo "    docker exec $DOCKER_CONTAINER npm install"
    fi
  else
    echo "${YELLOW}Docker container '${DOCKER_CONTAINER}' is not running.${NC}"
    echo "  Start it and install Docker deps:"
    echo "    docker compose --profile dev up -d"
    echo "    docker exec $DOCKER_CONTAINER npm install"
  fi

  echo ""

  # --- Host path (SMI-5343) --------------------------------------------------
  # The host node_modules tree feeds host tooling (tsc, eslint) and is symlinked
  # into every worktree — it must stay in sync with package-lock.json too.
  # BUT: in a linked worktree, node_modules (root + every packages/*/node_modules)
  # is itself a SYMLINK into the main checkout's tree (create-worktree.sh SMI-4377
  # + SMI-4381). Running `npm install` here would have npm's reify process UNLINK
  # those symlinks and rebuild real directories in their place, corrupting this
  # worktree's local state (SMI-5623) — this fires on ANY pull/merge in ANY
  # worktree with a lockfile change, not just a --delete-branch merge. Detect a
  # linked worktree via git-dir vs git-common-dir (same idiom as
  # scripts/lib/check-node-modules-fresh.sh) and skip-and-advise instead of
  # installing here; the human runs npm install in the MAIN checkout, where
  # node_modules is the real tree.
  if [ "$_IS_LINKED_WT" = "1" ]; then
    echo "${YELLOW}Skipping host npm install — this is a linked worktree.${NC}"
    echo "  node_modules here is a symlink into the main checkout; installing in"
    echo "  place would unlink it and corrupt this worktree's local state."
    if [ -n "$_MAIN_CHECKOUT" ]; then
      echo "  Run instead: ( cd \"$_MAIN_CHECKOUT\" && npm install )"
    else
      echo "  Run npm install in the main checkout instead."
    fi
  elif command -v npm > /dev/null 2>&1; then
    echo "${YELLOW}Installing updated dependencies on the host...${NC}"
    if npm install; then
      echo "${GREEN}  Host dependencies updated successfully.${NC}"
    else
      echo "${YELLOW}  Host npm install failed. Run manually:${NC}"
      echo "    npm install"
    fi
  else
    echo "${YELLOW}npm not found on host PATH — install dependencies manually:${NC}"
    echo "  npm install"
  fi

  # --- Host retrieval auto-heal (SMI-5426) -----------------------------------
  # Out-of-band: after the host install above completes, kick a detached, guarded
  # auto-heal of the host better-sqlite3 binding so ~6-week-dead retrieval
  # telemetry self-revives (SMI-4549 / SMI-5419). The script is fail-soft,
  # Docker-no-op, cheap-exits on a healthy host, serializes via a lock, backs off
  # on repeated failure, and is opt-out via SKILLSMITH_RETRIEVAL_AUTOHEAL_DISABLE=1.
  # --print-banner runs synchronously (prints only when broken); the heal runs
  # detached so it never blocks the hook. Firing AFTER the install above closes
  # the "wait for the parent install" gap. See
  # docs/internal/implementation/smi-5426-w01-host-autoheal.md.
  if command -v node > /dev/null 2>&1 && [ -f scripts/retrieval-autoheal.sh ]; then
    bash scripts/retrieval-autoheal.sh --print-banner 2>/dev/null || true
    nohup bash scripts/retrieval-autoheal.sh </dev/null >/dev/null 2>&1 &
  fi

  echo ""
fi

exit 0
